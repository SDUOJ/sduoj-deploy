{
  "spring": {
    "r2dbc": {
      "url": "r2dbc:mysql://sduoj-mysql:3306/sduoj?useUnicode=true&characterEncoding=utf-8&useSSL=false",
      "username": "${MYSQL_USER}",
      "password": "${MYSQL_PASSWORD}",
      "pool": {
        "enable": true,
        "initial-size": 10,
        "max-size": 100,
        "max-idle-time": "5m"
      }
    }
  },
  "sduoj": {
    "filesys": {
      "baseDir": "/app/filesys",
      "shared-output": {
        "enabled": true
      }
    },
    "feign": {
      "enableToken": true,
      "token": "${DEV_RPC_TOKEN}"
    }
  },
  "management": {
    "endpoints": {
      "web": {
        "exposure": {
          "include": "health,info"
        }
      }
    },
    "endpoint": {
      "health": {
        "showDetails": "never"
      }
    }
  }
}

# Copy to the guest-only private directory as mode0600; never commit actual values.
# NACOS_ADDR/NAMESPACE/IP and Worker identity are generated in Compose.
NACOS_USERNAME=
NACOS_PASSWORD=
# Must match Nacos/Gateway endpoint, DB2 and exact prefix, not an MBP SSH forward.
AUTOLAB_REDIS_URL=
IDE_REDIS_PREFIX=
IDE_PROBLEM_RESOLVER_URL=
IDE_RPC_TOKEN=

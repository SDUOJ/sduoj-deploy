# Copy values from the deployment's secret store. This file contains no credentials.
SDUOJ_MODE=release
SDUOJ_TOKEN=
AUTOLAB_MYSQL_ADDR=127.0.0.1:7360
AUTOLAB_MYSQL_USER=sduoj_ext_ps
AUTOLAB_MYSQL_DATABASE=sduoj_ext_problem_set
AUTOLAB_MYSQL_PASSWORD=
AUTOLAB_REDIS_ADDR=127.0.0.1:7361
AUTOLAB_REDIS_PASSWORD=
AUTOLAB_NACOS_ADDR=127.0.0.1:8848
AUTOLAB_NACOS_NAMESPACE=prod
AUTOLAB_AI_SECRET_KEY=
AUTOLAB_AI_DATA_DIR=/var/lib/sduoj-autolab
# Use the Gateway's actual direct peer CIDRs, never 0.0.0.0/0.
AUTOLAB_AI_TRUSTED_GATEWAY_CIDRS=127.0.0.1/32
AUTOLAB_START_TASK_WORKER=0
AUTOLAB_SANDBOX_ENABLED=0

        "resetEmailPattern": "<html>\n  <head></head>\n  <body> \n    <h2>Dear %s, </h2> \n    <br /> \u8bf7\u70b9\u51fb\u4ee5\u4e0b\u94fe\u63a5\u5bf9\u4f60\u7684\u8d26\u53f7\u8fdb\u884c\u91cd\u8bbe\u90ae\u7bb1\u9a8c\u8bc1 \n    <br /> \n    <div style=\"padding: 12px; background-color: #E0E0E0; color: #000000; font-weight: bold; font-size: 16px;\" align=\"center\"> \n    <a href=\"%s\">%s</a> \n    </div>\n    <div style=\"text-align: center;padding: 50px 50px 24px;color: #515a6e;font-size: 14px;\">\n    2020-2021 &copy; Shandong University\n    <br />[\u672c\u90ae\u4ef6\u4e3a\u7cfb\u7edf\u81ea\u52a8\u53d1\u9001\uff0c\u8bf7\u52ff\u76f4\u63a5\u56de\u590d]\n    </div>  \n  </body>\n</html>\n"
